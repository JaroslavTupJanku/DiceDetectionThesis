<Window x:Class="DiceDetector.View.DiceDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Detail kostky"
        Width="500" Height="820"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource Brush.Background}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Title -->
            <RowDefinition Height="Auto"/>  <!-- Image -->
            <RowDefinition Height="Auto"/>  <!-- Predicted value -->
            <RowDefinition Height="Auto"/>  <!-- Confidences -->
            <RowDefinition Height="Auto"/>  <!-- Position & crop -->
            <RowDefinition Height="Auto"/>  <!-- Eval metrics -->
            <RowDefinition Height="Auto"/>  <!-- Predictions header -->
            <RowDefinition Height="*"/>     <!-- Predictions list -->
            <RowDefinition Height="Auto"/>  <!-- Close button -->
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0" x:Name="TitleText" FontSize="20" FontWeight="SemiBold"
                   Foreground="{DynamicResource Brush.Text}" Margin="0,0,0,16"/>

        <!-- Crop image -->
        <Border Grid.Row="1" Background="{DynamicResource Brush.SurfaceAlt}"
                CornerRadius="10" Padding="8" Margin="0,0,0,16"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                HorizontalAlignment="Center">
            <Image x:Name="CropImageControl" MaxWidth="200" MaxHeight="200"
                   Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
        </Border>

        <!-- Predicted value -->
        <StackPanel Grid.Row="2" Orientation="Vertical" Margin="0,0,0,14" HorizontalAlignment="Center">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="Predikovaná hodnota:" FontSize="15"
                           Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center"
                           Margin="0,0,10,0"/>
                <Border Background="{DynamicResource Brush.Primary}" CornerRadius="8"
                        Padding="14,6" MinWidth="44">
                    <TextBlock x:Name="PredictedValueText" FontSize="22" FontWeight="Bold"
                               Foreground="White" HorizontalAlignment="Center"/>
                </Border>
            </StackPanel>
            <TextBlock x:Name="StatusText" FontSize="12" FontWeight="SemiBold"
                       HorizontalAlignment="Center" Margin="0,6,0,0"/>
        </StackPanel>

        <!-- Confidences -->
        <UniformGrid Grid.Row="3" Columns="3" Margin="0,0,0,16">
            <Border Background="{DynamicResource Brush.Surface}" CornerRadius="10" Padding="12" Margin="0,0,4,0"
                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="DETEKČNÍ JISTOTA" FontSize="10" FontWeight="Medium"
                               Foreground="{DynamicResource Brush.TextMuted}" Margin="0,0,0,4"/>
                    <TextBlock x:Name="DetConfidenceText" FontSize="20" FontWeight="Bold"
                               Foreground="{DynamicResource Brush.Warning}"/>
                </StackPanel>
            </Border>
            <Border Background="{DynamicResource Brush.Surface}" CornerRadius="10" Padding="12" Margin="4,0,4,0"
                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="KLASIFIKAČNÍ JISTOTA" FontSize="10" FontWeight="Medium"
                               Foreground="{DynamicResource Brush.TextMuted}" Margin="0,0,0,4"/>
                    <TextBlock x:Name="ClsConfidenceText" FontSize="20" FontWeight="Bold"
                               Foreground="{DynamicResource Brush.Success}"/>
                </StackPanel>
            </Border>
            <Border Background="{DynamicResource Brush.Surface}" CornerRadius="10" Padding="12" Margin="4,0,0,0"
                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="FINÁLNÍ JISTOTA" FontSize="10" FontWeight="Medium"
                               Foreground="{DynamicResource Brush.TextMuted}" Margin="0,0,0,4"/>
                    <TextBlock x:Name="FinalConfidenceText" FontSize="20" FontWeight="Bold"
                               Foreground="{DynamicResource Brush.Primary}"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Position & crop info -->
        <UniformGrid Grid.Row="4" Columns="3" Margin="0,0,0,16">
            <Border Background="{DynamicResource Brush.Surface}" CornerRadius="10" Padding="12" Margin="0,0,4,0"
                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="POZICE V OBRÁZKU" FontSize="10" FontWeight="Medium"
                               Foreground="{DynamicResource Brush.TextMuted}" Margin="0,0,0,4"/>
                    <TextBlock x:Name="BoxPositionText" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.Text}"/>
                </StackPanel>
            </Border>
            <Border Background="{DynamicResource Brush.Surface}" CornerRadius="10" Padding="12" Margin="4,0,4,0"
                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="ROZMĚR VÝŘEZU" FontSize="10" FontWeight="Medium"
                               Foreground="{DynamicResource Brush.TextMuted}" Margin="0,0,0,4"/>
                    <TextBlock x:Name="CropSizeText" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.Text}"/>
                </StackPanel>
            </Border>
            <Border Background="{DynamicResource Brush.Surface}" CornerRadius="10" Padding="12" Margin="4,0,0,0"
                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="PLOCHA DETEKCE" FontSize="10" FontWeight="Medium"
                               Foreground="{DynamicResource Brush.TextMuted}" Margin="0,0,0,4"/>
                    <TextBlock x:Name="AreaText" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.Text}"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Evaluation metrics (visible only when eval data exists) -->
        <Border Grid.Row="5" x:Name="EvalMetricsPanel" Background="{DynamicResource Brush.SurfaceAlt}"
                CornerRadius="10" Padding="12" Margin="0,0,0,16"
                BorderBrush="{DynamicResource Brush.Primary}" BorderThickness="1.5"
                Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="📊 Evaluace" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource Brush.Text}" Margin="0,0,0,6"/>
                <UniformGrid Columns="3">
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="GROUND TRUTH" FontSize="9" FontWeight="Medium"
                                   Foreground="{DynamicResource Brush.TextMuted}" Margin="0,0,0,2"/>
                        <TextBlock x:Name="GroundTruthText" FontSize="15" FontWeight="Bold"
                                   Foreground="{DynamicResource Brush.Primary}"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="IoU" FontSize="9" FontWeight="Medium"
                                   Foreground="{DynamicResource Brush.TextMuted}" Margin="0,0,0,2"/>
                        <TextBlock x:Name="IoUText" FontSize="15" FontWeight="Bold"
                                   Foreground="{DynamicResource Brush.Success}"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="TYP" FontSize="9" FontWeight="Medium"
                                   Foreground="{DynamicResource Brush.TextMuted}" Margin="0,0,0,2"/>
                        <TextBlock x:Name="MatchTypeText" FontSize="15" FontWeight="Bold"/>
                    </StackPanel>
                </UniformGrid>
            </StackPanel>
        </Border>

        <!-- Predictions header -->
        <TextBlock Grid.Row="6" Text="Rozložení pravděpodobnosti" FontSize="14" FontWeight="SemiBold"
                   Foreground="{DynamicResource Brush.Text}" Margin="0,0,0,8"/>

        <!-- All predictions (scrollable) -->
        <ScrollViewer Grid.Row="7" VerticalScrollBarVisibility="Auto" Margin="0,0,0,16">
            <ItemsControl x:Name="TopPredictionsList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Value number -->
                            <TextBlock Grid.Column="0" Text="{Binding Value}" FontSize="17" FontWeight="Bold"
                                       Foreground="{DynamicResource Brush.Text}" VerticalAlignment="Center"/>

                            <!-- Progress bar -->
                            <Grid Grid.Column="1" Margin="10,0">
                                <!-- Background track -->
                                <Border Background="#0a0a0a"
                                        CornerRadius="6" Height="24"
                                        BorderBrush="#505050" BorderThickness="1.5"/>
                                <!-- Filled bar with bright cyan gradient + glow -->
                                <Border CornerRadius="5" Height="22" Margin="1"
                                        HorizontalAlignment="Left"
                                        Width="{Binding BarWidth}">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#00D4FF" BlurRadius="8" 
                                                          ShadowDepth="0" Opacity="0.6"/>
                                    </Border.Effect>
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#00E5FF" Offset="0"/>
                                            <GradientStop Color="#00B8FF" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                            </Grid>

                            <!-- Percentage value -->
                            <TextBlock Grid.Column="2" Text="{Binding DisplayText}" 
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.Text}" 
                                       VerticalAlignment="Center"
                                       Margin="10,0,0,0"
                                       MinWidth="45"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Close button -->
        <Button Grid.Row="8" Content="Zavřít" Width="120" HorizontalAlignment="Right"
                Background="{DynamicResource Brush.ButtonGray}"
                Foreground="{DynamicResource Brush.Text}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                Click="CloseButton_Click"/>
    </Grid>
</Window>
