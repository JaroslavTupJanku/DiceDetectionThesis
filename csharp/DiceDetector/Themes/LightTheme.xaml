<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Light Theme  ·  clean, warm white -->
    <SolidColorBrush x:Key="Brush.Primary"         Color="#2563EB" />
    <SolidColorBrush x:Key="Brush.PrimaryDark"      Color="#1D4ED8" />
    <SolidColorBrush x:Key="Brush.Background"       Color="#F0F2F5" />
    <SolidColorBrush x:Key="Brush.Surface"          Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.SurfaceAlt"       Color="#F6F8FA" />
    <SolidColorBrush x:Key="Brush.Text"             Color="#1F2937" />
    <SolidColorBrush x:Key="Brush.TextMuted"        Color="#6B7280" />
    <SolidColorBrush x:Key="Brush.TextSubtle"       Color="#9CA3AF" />
    <SolidColorBrush x:Key="Brush.Border"           Color="#D1D5DB" />
    <SolidColorBrush x:Key="Brush.Success"          Color="#059669" />
    <SolidColorBrush x:Key="Brush.Warning"          Color="#D97706" />
    <SolidColorBrush x:Key="Brush.Error"            Color="#DC2626" />
    <SolidColorBrush x:Key="Brush.ButtonGreen"      Color="#16A34A" />
    <SolidColorBrush x:Key="Brush.ButtonBlue"       Color="#2563EB" />
    <SolidColorBrush x:Key="Brush.ButtonPurple"     Color="#7C3AED" />
    <SolidColorBrush x:Key="Brush.ButtonGray"       Color="#E5E7EB" />
    <SolidColorBrush x:Key="Brush.IconPrimary"      Color="#1F2937" />
    <SolidColorBrush x:Key="Brush.PlaceholderIcon"  Color="#D1D5DB" />
    <SolidColorBrush x:Key="Brush.ToggleTrack"      Color="#D1D5DB" />

</ResourceDictionary>
