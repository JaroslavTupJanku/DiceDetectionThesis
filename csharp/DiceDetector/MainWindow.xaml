<Window x:Class="DiceDetector.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DiceDetector"
        xmlns:conv="clr-namespace:DiceDetector.View.Converters"
        mc:Ignorable="d"
        Title="Detekce a analýza hracích kostek"
        Height="780"
        Width="1200"
        MinHeight="600"
        MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.Background}">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />

        <!-- Shared pill toggle base -->
        <Style x:Key="PillToggleBase" TargetType="ToggleButton">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Focusable" Value="False"/>
        </Style>

        <!-- Theme: 🌙 dark ↔ ☀️ light -->
        <Style x:Key="ThemeToggleStyle" TargetType="ToggleButton" BasedOn="{StaticResource PillToggleBase}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Track"
                                Background="{DynamicResource Brush.ToggleTrack}"
                                CornerRadius="14" Padding="8,0" Height="28" MinWidth="56">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="Icon" Text="🌙" FontSize="13"
                                           VerticalAlignment="Center" IsHitTestVisible="False"/>
                                <TextBlock x:Name="Lbl" Text="Tmavé" FontSize="11" Margin="5,0,0,0"
                                           Foreground="White" VerticalAlignment="Center"
                                           IsHitTestVisible="False"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Icon" Property="Text" Value="☀️"/>
                                <Setter TargetName="Lbl" Property="Text" Value="Světlé"/>
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource Brush.Primary}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Overlay colors: 🏢 elegant ↔ 🎉 vibrant -->
        <Style x:Key="ColorModeToggleStyle" TargetType="ToggleButton" BasedOn="{StaticResource PillToggleBase}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Track"
                                Background="{DynamicResource Brush.ToggleTrack}"
                                CornerRadius="14" Padding="8,0" Height="28" MinWidth="56">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="Icon" Text="🏢" FontSize="13"
                                           VerticalAlignment="Center" IsHitTestVisible="False"/>
                                <TextBlock x:Name="Lbl" Text="Elegantní" FontSize="11" Margin="5,0,0,0"
                                           Foreground="White" VerticalAlignment="Center"
                                           IsHitTestVisible="False"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Icon" Property="Text" Value="🎉"/>
                                <Setter TargetName="Lbl" Property="Text" Value="Veselé"/>
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource Brush.Primary}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StatCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Brush.Surface}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="CardTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="FontWeight" Value="Medium"/>
        </Style>

        <Style x:Key="CardValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="380" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ═══ Header ═══ -->
        <Border Grid.Row="0" Grid.ColumnSpan="3"
                Background="{DynamicResource Brush.Surface}"
                CornerRadius="14" Padding="20,14" Margin="0,0,0,12"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Vertical" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}">
                        Detekce a analýza hracích kostek
                    </TextBlock>
                    <TextBlock Text="WPF · MVVM · ONNX Runtime" Margin="0,2,0,0"
                               FontSize="11" Foreground="{DynamicResource Brush.TextMuted}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <!-- Toggle group -->
                    <Border Background="{DynamicResource Brush.SurfaceAlt}"
                            CornerRadius="16" Padding="3"
                            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                            Margin="0,0,12,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <ToggleButton Style="{StaticResource ThemeToggleStyle}"
                                          IsChecked="{Binding IsLightTheme}"
                                          ToolTip="Tmavý / Světlý režim"/>
                            <Rectangle Width="1" Margin="3,4" Fill="{DynamicResource Brush.Border}"/>
                            <ToggleButton Style="{StaticResource ColorModeToggleStyle}"
                                          IsChecked="{Binding IsVibrantOverlay}"
                                          ToolTip="Elegantní / Veselé barvy"/>
                        </StackPanel>
                    </Border>

                    <Button Content="Načíst" Width="80" Margin="0,0,6,0"
                            Command="{Binding OpenImageCommand}"
                            Background="{DynamicResource Brush.ButtonGreen}" Foreground="White"
                            ToolTip="Načíst obrázek ze souboru"/>
                    <Button Content="Kamera" Width="80" Margin="0,0,6,0"
                            Command="{Binding ToggleCameraCommand}"
                            Background="{DynamicResource Brush.ButtonBlue}" Foreground="White"/>
                    <Button Content="Zachytit" Width="80" Margin="0,0,6,0"
                            Command="{Binding CaptureFromCameraCommand}"
                            Background="{DynamicResource Brush.ButtonPurple}" Foreground="White"/>
                    <Button Content="Spustit AI" Width="100" Margin="0,0,6,0"
                            Command="{Binding RunInferenceCommand}"
                            IsEnabled="{Binding CanRunInference}"
                            Background="{DynamicResource Brush.Error}" Foreground="White"/>
                    <Button Content="Vyčistit" Width="80" Margin="0,0,6,0"
                            Command="{Binding ClearCommand}"
                            Background="{DynamicResource Brush.ButtonGray}"
                            Foreground="{DynamicResource Brush.Text}"
                            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"/>
                    <Button Content="Evaluace" Width="84" Margin="0"
                            Command="{Binding LoadAnnotationsCommand}"
                            Background="{DynamicResource Brush.ButtonBlue}" Foreground="White"
                            ToolTip="Načíst XML anotace pro evaluační režim (Pascal VOC)"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ═══ Statistics ═══ -->
        <UniformGrid Grid.Row="1" Grid.ColumnSpan="3" Columns="4" Margin="0,0,0,12">
            <Border Style="{StaticResource StatCardStyle}">
                <StackPanel>
                    <TextBlock Text="🎲  POČET KOSTEK" Style="{StaticResource CardTitleStyle}"/>
                    <TextBlock Text="{Binding DetectionCount}" Style="{StaticResource CardValueStyle}"/>
                    <TextBlock Text="{Binding DominantValueText}" FontSize="11" Margin="0,2,0,0"
                               Foreground="{DynamicResource Brush.TextMuted}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource StatCardStyle}">
                <StackPanel>
                    <TextBlock Text="∑  SOUČET HODNOT" Style="{StaticResource CardTitleStyle}"/>
                    <TextBlock Text="{Binding TotalValueText}" Style="{StaticResource CardValueStyle}"
                               Foreground="{DynamicResource Brush.Primary}"/>
                    <TextBlock Text="{Binding TotalValueBreakdownText}" FontSize="11"
                               Foreground="{DynamicResource Brush.TextMuted}" Margin="0,4,0,0"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource StatCardStyle}">
                <StackPanel>
                    <TextBlock Text="📊  PRŮMĚRNÁ SPOLEHLIVOST" Style="{StaticResource CardTitleStyle}"/>
                    <TextBlock Text="{Binding AverageConfidenceText}" Style="{StaticResource CardValueStyle}"
                               Foreground="{DynamicResource Brush.Success}"/>
                    <TextBlock Text="{Binding ConfidenceRangeText}" FontSize="11" Margin="0,2,0,0"
                               Foreground="{DynamicResource Brush.TextMuted}"/>
                    <TextBlock Text="{Binding ConfidenceDetailText}" FontSize="10" Margin="0,1,0,0"
                               Foreground="{DynamicResource Brush.TextSubtle}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource StatCardStyle}" Margin="0">
                <StackPanel>
                    <TextBlock Text="⚠  NEJISTÉ VÝSLEDKY" Style="{StaticResource CardTitleStyle}"/>
                    <TextBlock Text="{Binding UncertainCountText}" Style="{StaticResource CardValueStyle}"
                               Foreground="{DynamicResource Brush.Warning}"/>
                    <TextBlock Text="final &lt; 70%" FontSize="11" Margin="0,2,0,0"
                               Foreground="{DynamicResource Brush.TextMuted}"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- ═══ Image viewport ═══ -->
        <Border Grid.Row="2" Grid.Column="0"
                Background="{DynamicResource Brush.Surface}"
                CornerRadius="14"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                Padding="8">
            <Grid>
                <!-- Placeholder when no image -->
                <Border Background="{DynamicResource Brush.SurfaceAlt}" CornerRadius="10"
                        Visibility="{Binding IsImageLoaded, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverted}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.5">
                        <TextBlock Text="📷" FontSize="64" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource Brush.PlaceholderIcon}"/>
                        <TextBlock Text="Žádný obrázek" FontSize="16" Margin="0,12,0,0"
                                   Foreground="{DynamicResource Brush.TextMuted}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Načtěte obrázek nebo použijte kameru" FontSize="13" Margin="0,4,0,0"
                                   Foreground="{DynamicResource Brush.TextSubtle}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Image + overlay -->
                <Viewbox Stretch="Uniform">
                    <Grid>
                        <Image Source="{Binding DisplayedImage}" Stretch="None"/>
                        <!-- Regular detection overlay (hidden when eval mode has results) -->
                        <Canvas>
                            <ItemsControl ItemsSource="{Binding OverlayItems}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><Canvas/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style>
                                        <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                        <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Width="{Binding Width}" Height="{Binding Height}">
                                            <Border BorderBrush="{Binding Color}" BorderThickness="{Binding StrokeThickness}"
                                                    CornerRadius="{Binding BoxCornerRadius}"/>
                                            <Border Background="{Binding Color}"
                                                    CornerRadius="{Binding LabelCornerRadius}"
                                                    Padding="{Binding LabelPadding}"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Top"
                                                    Margin="{Binding LabelMargin}">
                                                <TextBlock Text="{Binding Label}"
                                                           Foreground="White" FontWeight="Bold" FontSize="{Binding LabelFontSize}"/>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Canvas>
                        <!-- Eval overlay -->
                        <Canvas Visibility="{Binding IsEvalMode, Converter={StaticResource BoolToVisibilityConverter}}">
                            <ItemsControl ItemsSource="{Binding EvalOverlayItems}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><Canvas/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style>
                                        <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                        <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Width="{Binding Width}" Height="{Binding Height}">
                                            <!-- Tinted fill -->
                                            <Border Background="{Binding Color}" Opacity="0.15"
                                                    CornerRadius="{Binding BoxCornerRadius}"/>
                                            <!-- Border -->
                                            <Border BorderBrush="{Binding Color}" BorderThickness="{Binding StrokeThickness}"
                                                    CornerRadius="{Binding BoxCornerRadius}"/>
                                            <!-- Label tag for non-missed items -->
                                            <Border Background="{Binding Color}"
                                                    CornerRadius="{Binding LabelCornerRadius}"
                                                    Padding="{Binding LabelPadding}"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Top"
                                                    Margin="{Binding LabelMargin}"
                                                    Visibility="{Binding IsNotMissed, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <TextBlock Text="{Binding Label}"
                                                           Foreground="White" FontWeight="Bold" FontSize="{Binding LabelFontSize}"/>
                                            </Border>
                                            <!-- Centered cross for missed items -->
                                                                 <TextBlock Text="✕"
                                                                            Foreground="{Binding Color}"
                                                                            FontSize="{Binding CenterFontSize}"
                                                                            FontWeight="ExtraBold" Opacity="0.5"
                                                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                            Visibility="{Binding IsDashed, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                             </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <!-- Missed dice counter overlay (top-right corner of image) -->
                                                <Border Background="#DC143C" CornerRadius="6" Padding="8,4"
                                                        Canvas.Right="10" Canvas.Top="10"
                                                        Visibility="{Binding HasMissedDice, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="✕" FontSize="14" FontWeight="Bold" Foreground="White"
                                                                   Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                        <TextBlock Foreground="White" FontWeight="SemiBold" FontSize="12">
                                                            <Run Text="Nenalezeno:"/>
                                                            <Run Text="{Binding MissedDiceCount, Mode=OneWay}" FontWeight="Bold"/>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Border>
                                            </Canvas>
                    </Grid>
                </Viewbox>
            </Grid>
        </Border>

        <!-- ═══ Results panel ═══ -->
        <Border Grid.Row="2" Grid.Column="2"
                Background="{DynamicResource Brush.Surface}"
                CornerRadius="14"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Padding="16,14"
                        Background="{DynamicResource Brush.SurfaceAlt}"
                        CornerRadius="14,14,0,0"
                        BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
                    <TextBlock Text="Všechny detekce" FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.Text}"/>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="10,10,10,10">
                    <ItemsControl ItemsSource="{Binding Results}" Margin="0,0,45,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource Brush.SurfaceAlt}"
                                        CornerRadius="10" Padding="12" Margin="0,0,0,8"
                                        BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                                        Cursor="Hand" ToolTip="Klikněte pro detail">
                                    <Border.InputBindings>
                                        <MouseBinding Gesture="LeftClick"
                                                      Command="{Binding DataContext.ShowDiceDetailCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      CommandParameter="{Binding}"/>
                                    </Border.InputBindings>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Color dot matching overlay -->
                                        <Border Grid.Column="0"
                                                Background="{Binding ColorBrush}"
                                                Width="38" Height="38"
                                                CornerRadius="8"
                                                VerticalAlignment="Top" Margin="0,0,10,0">
                                            <TextBlock Text="{Binding Index}"
                                                       Foreground="White" FontWeight="Bold" FontSize="16"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <DockPanel Margin="0,0,0,2">
                                                <TextBlock Text="{Binding Label}" FontSize="13" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Brush.Text}"/>
                                                <TextBlock Text="{Binding ValueText}" FontSize="13" FontWeight="Bold"
                                                           Foreground="{DynamicResource Brush.Primary}" Margin="8,0,0,0"/>
                                            </DockPanel>
                                            <TextBlock Text="{Binding ConfidenceText}" FontSize="11"
                                                       Foreground="{DynamicResource Brush.TextMuted}"/>
                                            <TextBlock Text="{Binding BoxText}" FontSize="10" Margin="0,1,0,0"
                                                       Foreground="{DynamicResource Brush.TextSubtle}"/>
                                        </StackPanel>

                                        <!-- Status indicator -->
                                        <Border Grid.Column="2" VerticalAlignment="Center" Margin="8,0,4,0"
                                                Background="{Binding StatusBrush}"
                                                CornerRadius="10" Padding="8,3" MinWidth="32">
                                            <TextBlock Text="{Binding StatusIcon}"
                                                       Foreground="White" FontWeight="Bold" FontSize="10"
                                                       HorizontalAlignment="Center"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Distribution + uncertain section -->
                <Border Grid.Row="2" Padding="12"
                        Visibility="{Binding HasDetections, Converter={StaticResource BoolToVisibilityConverter}}"
                        BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0">
                    <StackPanel>
                        <TextBlock Text="Distribuce hodnot" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.Text}" Margin="0,0,0,8"/>

                        <!-- Mini bar chart -->
                        <ItemsControl ItemsSource="{Binding ValueDistribution}" Height="100">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel LastChildFill="False">
                                        <TextBlock DockPanel.Dock="Bottom" Text="{Binding Value}"
                                                   FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Brush.TextMuted}"
                                                   HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                        <Border DockPanel.Dock="Bottom"
                                                Height="{Binding BarHeight}" Width="28"
                                                Background="{DynamicResource Brush.Primary}"
                                                CornerRadius="4,4,0,0" Margin="0,2,0,0"/>
                                        <TextBlock DockPanel.Dock="Bottom" Text="{Binding CountText}"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource Brush.Text}"
                                                   HorizontalAlignment="Center"/>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Uncertain detections -->
                        <Border Background="{DynamicResource Brush.SurfaceAlt}" CornerRadius="8"
                                Padding="10,8" Margin="0,10,0,0"
                                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚠" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Nejisté detekce (final &lt; 0.70):" FontSize="12"
                                           Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding UncertainCountText}" FontSize="14" FontWeight="Bold"
                                           Foreground="{DynamicResource Brush.Warning}" Margin="6,0,0,0"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- ━━━ Eval mode results ━━━ -->
                        <Border Background="{DynamicResource Brush.SurfaceAlt}" CornerRadius="10"
                                Padding="12,10" Margin="0,10,0,0"
                                BorderBrush="{DynamicResource Brush.Primary}" BorderThickness="1.5"
                                Visibility="{Binding IsEvalMode, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <TextBlock Text="📋 Evaluace" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Brush.Text}" DockPanel.Dock="Left"
                                               VerticalAlignment="Center"/>
                                    <Button Content="✕" FontSize="12" DockPanel.Dock="Right"
                                            HorizontalAlignment="Right" Padding="8,2"
                                            Command="{Binding DisableEvalModeCommand}"
                                            Background="{DynamicResource Brush.ButtonGray}"
                                            Foreground="{DynamicResource Brush.Text}"
                                            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                                            ToolTip="Vypnout eval režim"/>
                                </DockPanel>

                                <TextBlock Text="{Binding EvalStatusText}" FontSize="11"
                                           Foreground="{DynamicResource Brush.TextMuted}" TextWrapping="Wrap"
                                           Margin="0,0,0,8"/>

                                <!-- Eval legend with colored pills -->
                                <TextBlock Text="Barevné značení na obrázku:" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Brush.Text}" Margin="0,0,0,4"/>
                                <WrapPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <Border Background="#32CD32" CornerRadius="3" Padding="6,2" Margin="0,0,6,4">
                                        <TextBlock Text="Správné" FontSize="10" Foreground="White" FontWeight="SemiBold"/>
                                    </Border>
                                    <Border Background="#FFA500" CornerRadius="3" Padding="6,2" Margin="0,0,6,4">
                                        <TextBlock Text="Špatná klas." FontSize="10" Foreground="White" FontWeight="SemiBold"/>
                                    </Border>
                                    <Border Background="#DC143C" CornerRadius="3" Padding="6,2" Margin="0,0,6,4">
                                        <TextBlock Text="False positive" FontSize="10" Foreground="White" FontWeight="SemiBold"/>
                                    </Border>
                                    <Border Background="#DC143C" CornerRadius="3" Padding="6,2" Margin="0,0,0,4">
                                        <TextBlock Text="Chybějící (✕)" FontSize="10" Foreground="White" FontWeight="SemiBold"/>
                                    </Border>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ═══ Status bar ═══ -->
        <Border Grid.Row="3" Grid.ColumnSpan="3"
                Background="{DynamicResource Brush.Surface}"
                CornerRadius="14" Padding="16,10" Margin="0,12,0,0"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Fill="{DynamicResource Brush.Success}"
                             Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding StatusText}" FontSize="13"
                               Foreground="{DynamicResource Brush.Text}" VerticalAlignment="Center"/>
                </StackPanel>

                <ProgressBar Grid.Column="1" Height="4" Margin="16,0"
                             Value="{Binding ProgressValue, Mode=OneWay}"
                             Visibility="{Binding ShowProgress, Converter={StaticResource BoolToVisibilityConverter}}"
                             Maximum="100"
                             Background="{DynamicResource Brush.Border}"
                             Foreground="{DynamicResource Brush.Primary}"
                             BorderThickness="0" VerticalAlignment="Center"/>



                <TextBlock Grid.Column="2" FontSize="11" VerticalAlignment="Center">
                    <Run Text="{Binding InferenceTimeText, Mode=OneWay}" Foreground="{DynamicResource Brush.Warning}"/>
                    <Run Text=" · " Foreground="{DynamicResource Brush.TextSubtle}"/>
                    <Run Text="ONNX Runtime" Foreground="{DynamicResource Brush.TextSubtle}"/>
                </TextBlock>
            </Grid>
        </Border>
    </Grid>
</Window>
